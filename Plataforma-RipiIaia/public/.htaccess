# Configuração de Cache e Otimização para Plesk
# Copie este arquivo para a raiz do seu domínio no servidor Plesk
# ou adicione essas configurações ao .htaccess existente

# ----------------------------------------------------------------------
# | Compressão Gzip/Deflate                                            |
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  # Força a compressão para tipos de conteúdo que geralmente não são comprimidos
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE "application/javascript" \
                                  "application/json" \
                                  "application/ld+json" \
                                  "application/manifest+json" \
                                  "application/rss+xml" \
                                  "application/schema+json" \
                                  "application/x-javascript" \
                                  "application/xml" \
                                  "text/css" \
                                  "text/html" \
                                  "text/javascript" \
                                  "text/plain" \
                                  "text/xml"
  </IfModule>
</IfModule>

# ----------------------------------------------------------------------
# | Cache de navegador                                                 |
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive on
  ExpiresDefault                                      "access plus 1 month"

  # CSS
  ExpiresByType text/css                              "access plus 1 year"

  # Arquivos de dados
  ExpiresByType application/json                      "access plus 0 seconds"
  ExpiresByType application/xml                       "access plus 0 seconds"
  ExpiresByType text/xml                              "access plus 0 seconds"

  # Favicon (não pode ser renomeado!)
  ExpiresByType image/x-icon                          "access plus 1 week"

  # HTML
  ExpiresByType text/html                             "access plus 0 seconds"

  # JavaScript
  ExpiresByType application/javascript                "access plus 1 year"
  ExpiresByType application/x-javascript              "access plus 1 year"
  ExpiresByType text/javascript                       "access plus 1 year"

  # Manifestos
  ExpiresByType application/manifest+json             "access plus 1 week"

  # Mídia
  ExpiresByType audio/ogg                             "access plus 1 month"
  ExpiresByType image/avif                            "access plus 1 year"
  ExpiresByType image/bmp                             "access plus 1 month"
  ExpiresByType image/gif                             "access plus 1 month"
  ExpiresByType image/jpeg                            "access plus 1 month"
  ExpiresByType image/png                             "access plus 1 month"
  ExpiresByType image/svg+xml                         "access plus 1 month"
  ExpiresByType image/webp                            "access plus 1 month"
  ExpiresByType video/mp4                             "access plus 1 month"
  ExpiresByType video/ogg                             "access plus 1 month"
  ExpiresByType video/webm                            "access plus 1 month"

  # Fontes da Web
  ExpiresByType font/woff                             "access plus 1 month"
  ExpiresByType font/woff2                            "access plus 1 month"
  ExpiresByType application/font-woff                 "access plus 1 month"
  ExpiresByType application/font-woff2                "access plus 1 month"
  ExpiresByType font/ttf                              "access plus 1 month"
  ExpiresByType font/otf                              "access plus 1 month"
  ExpiresByType font/eot                              "access plus 1 month"
</IfModule>

# ----------------------------------------------------------------------
# | Cabeçalhos de controle de cache                                   |
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # 1 ANO
  <FilesMatch "\.(eot|ico|otf|ttf|woff|woff2)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>

  # 1 MÊS
  <FilesMatch "\.(avif|bmp|gif|jpg|jpeg|jxr|png|svg|svgz|webp|mp4|ogg|webm)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>

  # 1 SEMANA
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "max-age=604800, public"
  </FilesMatch>

  # Sem cache (atualização constante)
  <FilesMatch "\.(html|json|xml)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
  </FilesMatch>
  
  # Ative o Cross-origin Resource Sharing (CORS)
  <FilesMatch "\.(eot|otf|tt[cf]|woff2?)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# | Configuração de ETags                                              |
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>

FileETag None

# ----------------------------------------------------------------------
# | Configuração de mime-types                                        |
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
  # Tipos de arquivos de áudio
  AddType audio/mp4                                   m4a f4a f4b
  AddType audio/ogg                                   oga ogg opus

  # Tipos de arquivos de vídeo
  AddType video/mp4                                   mp4 m4v f4v f4p
  AddType video/ogg                                   ogv
  AddType video/webm                                  webm

  # Tipos de arquivos de imagem
  AddType image/avif                                  avif
  AddType image/webp                                  webp

  # Tipos de fontes
  AddType font/woff                                   woff
  AddType font/woff2                                  woff2
  AddType application/vnd.ms-fontobject               eot
  AddType font/ttf                                    ttf
  AddType font/otf                                    otf
</IfModule>

# ----------------------------------------------------------------------
# | Proteger arquivos importantes                                     |
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Bloquear acesso direto a arquivos sensíveis
  RewriteRule (^|/)\.(?!well-known) - [F]
  RewriteRule (^|/)(?:package\.json|package-lock\.json|composer\.json|composer\.lock|yarn\.lock)$ - [F]
  RewriteRule ^node_modules/.*$ - [F]
  RewriteRule ^scripts/.*$ - [F]
  
  # Redirecionar todas as requisições para o index.html (SPA)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# | Segurança                                                         |
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # Proteção contra MIME-type sniffing
  Header set X-Content-Type-Options "nosniff"
  
  # Proteção contra XSS
  Header set X-XSS-Protection "1; mode=block"
  
  # Desabilitar incorporação em sites de terceiros
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ----------------------------------------------------------------------
# | Configuração para Single Page Application (SPA)                    |
# ----------------------------------------------------------------------
# Redireciona todas as requisições para index.html para permitir o roteamento pelo React Router
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
