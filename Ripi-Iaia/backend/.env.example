# Configurações do Banco de Dados
DB_HOST=localhost
DB_USER=ripiiaia_user
DB_PASSWORD=senha_segura
DB_NAME=ripiiaia_db

# Chave JWT para autenticação
JWT_SECRET=chave_muito_secreta_para_tokens_jwt

# Pasta para uploads (opcional)
UPLOAD_DIR=/home/achilles/Documentos/Ripi-Iaia/Ong-Ripiiaia/Ripi-Iaia/backend/public/uploads

# Configurações de CORS (deixe vazio para permitir todas as origens em desenvolvimento)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Porta do servidor (padrão 5000)
PORT=5000
